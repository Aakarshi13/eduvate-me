PORT=5000
NODE_ENV=development

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/eduvate
# For MongoDB Atlas cloud: mongodb+srv://username:password@cluster.mongodb.net/eduvate

# JWT
JWT_SECRET=eduvate-secret-key-2024-secure
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:8080
